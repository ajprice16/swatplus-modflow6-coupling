{
  "$defs": {
    "ChecksSection": {
      "additionalProperties": false,
      "properties": {
        "allow_nonconvergence_steps": {
          "default": 0,
          "description": "Non-converged days tolerated before stopping.",
          "minimum": 0,
          "title": "Allow Nonconvergence Steps",
          "type": "integer"
        },
        "enforce_invariants": {
          "default": true,
          "description": "Stop the run when a coupling invariant fails.",
          "title": "Enforce Invariants",
          "type": "boolean"
        },
        "mass_balance_tolerance_percent": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 5.0,
          "title": "Mass Balance Tolerance Percent",
          "type": "number"
        }
      },
      "title": "ChecksSection",
      "type": "object"
    },
    "ConnectionsSection": {
      "additionalProperties": false,
      "properties": {
        "channel_cells": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional channel_cells.csv (the GIS-side channel <-> cell table). Not needed to run; when given, validate cross-checks it against sfr_reaches.csv and the run reports the channel flow from off-grid channel length that is injected into in-grid reaches (daily column runoff_from_offgrid_length_m3).",
          "title": "Channel Cells"
        },
        "channel_reaches": {
          "description": "SWAT+ channel <-> MF6 SFR reach table sfr_reaches.csv (rno, channel_id, seq, layer, row, col, length_m).",
          "format": "path",
          "title": "Channel Reaches",
          "type": "string"
        },
        "grid": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional grid.json. When given, validate checks it against the MODFLOW discretization and the project CRS.",
          "title": "Grid"
        },
        "hru_cells": {
          "description": "HRU <-> cell table hru_cells.csv (hru_id, layer, row, col, area_m2, fraction).",
          "format": "path",
          "title": "Hru Cells",
          "type": "string"
        },
        "well_cells": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional pumping table well_cells.csv (layer, row, col, rate_m3d; MODFLOW sign: negative = extraction). Added to the run as an extra WEL package.",
          "title": "Well Cells"
        }
      },
      "required": [
        "hru_cells",
        "channel_reaches"
      ],
      "title": "ConnectionsSection",
      "type": "object"
    },
    "CouplingSection": {
      "additionalProperties": false,
      "properties": {
        "et_extinction_depth_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the EVT extinction depth when set; otherwise the EVT package value is used.",
          "title": "Et Extinction Depth M"
        },
        "evt_monthly_factors": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional 12 multipliers (January..December) applied to the EVT package rate. No default: the model's own rate is used unchanged when omitted.",
          "title": "Evt Monthly Factors"
        },
        "mode": {
          "const": "sequential_daily",
          "default": "sequential_daily",
          "description": "SWAT+ runs first; MODFLOW 6 then advances one day at a time through libmf6, with SFR runoff and recharge set in memory from the SWAT+ daily output.",
          "title": "Mode",
          "type": "string"
        },
        "pumping_scale": {
          "default": 1.0,
          "description": "Multiplier on well rates (0 disables pumping).",
          "minimum": 0,
          "title": "Pumping Scale",
          "type": "number"
        },
        "recharge_delay_days": {
          "default": 0.0,
          "description": "Vadose-zone delay (SWAT gw_delay form). 0 passes percolation through unchanged.",
          "minimum": 0,
          "title": "Recharge Delay Days",
          "type": "number"
        },
        "recharge_to_water_table": {
          "default": true,
          "description": "Apply recharge to the highest active cell.",
          "title": "Recharge To Water Table",
          "type": "boolean"
        },
        "recharge_update": {
          "default": "monthly",
          "enum": [
            "daily",
            "monthly",
            "monthly_ramped"
          ],
          "title": "Recharge Update",
          "type": "string"
        },
        "transmission_loss": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransmissionLossSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "well_auto_flow_reduce": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AUTO_FLOW_REDUCE fraction for wells added from connections.well_cells (throttle pumping as the cell thins). None = off.",
          "title": "Well Auto Flow Reduce"
        }
      },
      "title": "CouplingSection",
      "type": "object"
    },
    "ModflowSection": {
      "additionalProperties": false,
      "properties": {
        "initial_heads": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Binary head file whose last record is used as starting heads. Default: the IC package.",
          "title": "Initial Heads"
        },
        "libmf6": {
          "description": "Path to the libmf6 shared library (.so / .dylib / .dll).",
          "format": "path",
          "title": "Libmf6",
          "type": "string"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GWF model name; may be omitted when the simulation has one model.",
          "title": "Model Name"
        },
        "sim_dir": {
          "description": "MODFLOW 6 simulation directory holding mfsim.nam and the static packages.",
          "format": "path",
          "title": "Sim Dir",
          "type": "string"
        },
        "solver": {
          "$ref": "#/$defs/SolverSection"
        }
      },
      "required": [
        "sim_dir",
        "libmf6"
      ],
      "title": "ModflowSection",
      "type": "object"
    },
    "OutputSection": {
      "additionalProperties": false,
      "properties": {
        "directory": {
          "default": "results",
          "format": "path",
          "title": "Directory",
          "type": "string"
        },
        "prefix": {
          "default": "coupled_",
          "pattern": "^[A-Za-z0-9_.-]*$",
          "title": "Prefix",
          "type": "string"
        },
        "save_budget": {
          "default": true,
          "title": "Save Budget",
          "type": "boolean"
        },
        "save_daily_summary": {
          "default": true,
          "title": "Save Daily Summary",
          "type": "boolean"
        },
        "save_heads": {
          "default": true,
          "title": "Save Heads",
          "type": "boolean"
        },
        "save_reach_flows": {
          "default": false,
          "description": "Also write per-reach daily outflow and stream-aquifer exchange.",
          "title": "Save Reach Flows",
          "type": "boolean"
        }
      },
      "title": "OutputSection",
      "type": "object"
    },
    "PeriodSection": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "spinup_days": {
          "default": 0,
          "description": "Days run before 'start' whose output is discarded.",
          "minimum": 0,
          "title": "Spinup Days",
          "type": "integer"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PeriodSection",
      "type": "object"
    },
    "SolverSection": {
      "additionalProperties": false,
      "properties": {
        "complexity": {
          "default": "complex",
          "enum": [
            "simple",
            "moderate",
            "complex"
          ],
          "title": "Complexity",
          "type": "string"
        },
        "inner_dvclose": {
          "default": 0.0001,
          "exclusiveMinimum": 0,
          "title": "Inner Dvclose",
          "type": "number"
        },
        "inner_maximum": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Inner Maximum",
          "type": "integer"
        },
        "inner_rclose": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Residual closure of the linear solver (model volume/time). Default: the value implied by 'complexity'.",
          "title": "Inner Rclose"
        },
        "newton": {
          "default": true,
          "description": "Use the Newton-Raphson formulation (recommended for dry/rewetting cells).",
          "title": "Newton",
          "type": "boolean"
        },
        "outer_dvclose": {
          "default": 0.001,
          "description": "Head-change closure (model length units).",
          "exclusiveMinimum": 0,
          "title": "Outer Dvclose",
          "type": "number"
        },
        "outer_maximum": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Outer Maximum",
          "type": "integer"
        },
        "under_relaxation": {
          "default": true,
          "title": "Under Relaxation",
          "type": "boolean"
        }
      },
      "title": "SolverSection",
      "type": "object"
    },
    "SwatPlusSection": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SWAT+ executable path or name on PATH. Required when run_swatplus is true.",
          "title": "Executable"
        },
        "run_swatplus": {
          "default": true,
          "description": "Run SWAT+ before MODFLOW. False reuses the daily outputs already in txtinout.",
          "title": "Run Swatplus",
          "type": "boolean"
        },
        "txtinout": {
          "description": "SWAT+ TxtInOut directory (inputs, and outputs once run).",
          "format": "path",
          "title": "Txtinout",
          "type": "string"
        }
      },
      "required": [
        "txtinout"
      ],
      "title": "SwatPlusSection",
      "type": "object"
    },
    "TransmissionLossSection": {
      "additionalProperties": false,
      "properties": {
        "duration_h": {
          "default": 12.0,
          "description": "Hours per day of flow-weighted loss.",
          "exclusiveMinimum": 0,
          "maximum": 24,
          "title": "Duration H",
          "type": "number"
        },
        "k_mm_per_h": {
          "description": "Effective channel-bed hydraulic conductivity.",
          "exclusiveMinimum": 0,
          "title": "K Mm Per H",
          "type": "number"
        }
      },
      "required": [
        "k_mm_per_h"
      ],
      "title": "TransmissionLossSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "$ref": "#/$defs/ChecksSection"
    },
    "connections": {
      "$ref": "#/$defs/ConnectionsSection"
    },
    "coupling": {
      "$ref": "#/$defs/CouplingSection"
    },
    "crs": {
      "description": "Projected CRS shared by every spatial input, e.g. 'EPSG:<code>'.",
      "title": "Crs",
      "type": "string"
    },
    "modflow": {
      "$ref": "#/$defs/ModflowSection"
    },
    "name": {
      "description": "Free-text project label used in output metadata.",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/OutputSection"
    },
    "period": {
      "$ref": "#/$defs/PeriodSection"
    },
    "schema_version": {
      "const": 1,
      "description": "Project file format version.",
      "title": "Schema Version",
      "type": "integer"
    },
    "swatplus": {
      "$ref": "#/$defs/SwatPlusSection"
    }
  },
  "required": [
    "schema_version",
    "name",
    "crs",
    "swatplus",
    "modflow",
    "connections",
    "period"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
